#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "Checking system build prerequisites"
missing=()
for package in build-essential ca-certificates curl git xz-utils; do
    if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != "install ok installed" ]]; then
        missing+=("$package")
    fi
done
if (( ${#missing[@]} )); then
    sudo -n apt-get update
    sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
fi

echo "Installing the Rust toolchain from rust-toolchain.toml"
if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs |
        sh -s -- -y --profile minimal --default-toolchain none --no-modify-path
fi
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
rustup toolchain install --no-self-update --no-update

echo "Checking Zig 0.16.0"
zig_version="0.16.0"
case "$(uname -m)" in
    x86_64)
        zig_arch="x86_64"
        zig_checksum="70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00"
        ;;
    aarch64)
        zig_arch="aarch64"
        zig_checksum="ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17"
        ;;
    *) echo "Unsupported orb architecture: $(uname -m)" >&2; exit 1 ;;
esac
zig_dir="$HOME/.local/share/zig-$zig_version"
if [[ ! -x "$zig_dir/zig" ]]; then
    scratch="$(mktemp -d)"
    trap 'rm -rf "$scratch"' EXIT
    archive="zig-$zig_arch-linux-$zig_version"
    curl --proto '=https' --tlsv1.2 -fSL --retry 3 \
        "https://ziglang.org/download/$zig_version/$archive.tar.xz" -o "$scratch/zig.tar.xz"
    printf '%s  %s\n' "$zig_checksum" "$scratch/zig.tar.xz" | sha256sum -c -
    tar -xJf "$scratch/zig.tar.xz" -C "$scratch"
    mkdir -p "$HOME/.local/share"
    mv "$scratch/$archive" "$zig_dir"
fi
[[ "$("$zig_dir/zig" version)" == "$zig_version" ]]
mkdir -p "$HOME/.local/bin"
ln -sfn "$zig_dir/zig" "$HOME/.local/bin/zig"

# Setup's environment does not carry over to Amp or supervised service shells.
# Bash reads only the first readable login profile; don't shadow an existing one.
login_profile="$HOME/.bash_profile"
for candidate in .bash_profile .bash_login .profile; do
    if [[ -r "$HOME/$candidate" ]]; then
        login_profile="$HOME/$candidate"
        break
    fi
done
if ! grep -Fqx '# multiplexer orb toolchains' "$login_profile" 2>/dev/null; then
    cat >> "$login_profile" <<EOF

# multiplexer orb toolchains
case "\$PWD" in
"$repo_root"|"$repo_root/"*)
    export PATH="\$HOME/.cargo/bin:\$HOME/.local/bin:\$PATH"
    ;;
esac
EOF
fi

echo "Building locked dependencies and all targets (including the pinned Ghostty library)"
time cargo build --locked --all-targets
echo "Orb setup ready"
